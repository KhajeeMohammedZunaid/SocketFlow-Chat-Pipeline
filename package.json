{
  "name": "socketflow-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "cli": "npm run cli --workspace=packages/engine --",
    "dev": "npm run dev --workspace=apps/studio",
    "dev:studio": "npm run dev --workspace=apps/studio",
    "dev:engine": "npm run dev --workspace=packages/engine",
    "start:engine": "npm run start --workspace=packages/engine",
    "start:studio": "npm run start --workspace=apps/studio",
    "build:engine": "npm run build --workspace=packages/engine",
    "build:studio": "npm run build --workspace=apps/studio",
    "build": "npm run build --workspace=packages/engine && npm run build --workspace=apps/studio",
    "test": "npm run test --workspace=packages/engine",
    "benchmark": "npm run benchmark --workspace=packages/engine"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.32",
    "typescript": "^5.7.0"
  }
}
